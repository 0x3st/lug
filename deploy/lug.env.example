# Lug 服务端环境变量（复制到 /etc/lug.env，权限 600）
# 未列出的变量见 crates/lug-server/src/config.rs 模块文档。

# ---- 监听 ----
# 只监听本机，由 Caddy/Nginx 反代对外提供 HTTPS
HOST=127.0.0.1
PORT=8000

# ---- 存储 ----
# API Key 存储（与 Python 原型同格式；运行中的服务端不感知外部修改，
# lugctl 操作需在服务端停止时进行，v1-alpha 限制）
API_KEYS_PATH=/opt/lug/api_keys.json
# 前端构建产物目录：使用绝对路径，避免静态资源路径校验返回 404
WEB_DIR=/opt/lug/web

# ---- 运算预算护栏（§3.1 / §3.7）----
# 单值十进制位数上限（10^7 位 ≈ 10MB/值）
LUG_MAX_VALUE_DIGITS=10000000
# 表达式长度上限（字符）
LUG_MAX_EXPR_LEN=1024

# ---- GitHub 登录（控制台 OAuth 用；不配置则登录按钮禁用，Key 可用 lugctl 管理）----
# LUG_PUBLIC_URL=https://lug.by530.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
AUDIT_LOG_PATH=audit.log
